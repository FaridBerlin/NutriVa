MONGO_URL=
DATABASE=
PORT=3000

FRONTEND_URL=http://localhost:5173

JWT_SECRET=
COOKIE_EXPIRE=24
JWT_EXPIRE=24h
NODE_ENV=development

EMAIL_USER=
EMAIL_PASS=

# Ollama. Defaults to the hosted service (https://ollama.com), which needs an
# API key. Point OLLAMA_HOST at http://127.0.0.1:11434 to use a local instance.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_api_key_here
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_CHAT_MODEL=gpt-oss:120b
